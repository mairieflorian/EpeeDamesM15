<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Feuilles de Poules — Epée - Dames - M15</title>
  <style>
    :root {
      --bg: #eef2f6;
      --paper: #ffffff;
      --ink: #0f172a;
      --muted: #475569;
      --line: #1e293b;
      --grid: #cbd5e1;
      --diag: #e2e8f0;
      --accent: #0f766e;
      --accent-bg: #f0fdfa;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background: var(--bg);
      color: var(--ink);
      padding: 16px;
    }

    .top-bar {
      max-width: 1120px;
      margin: 0 auto 20px;
      background: var(--paper);
      border: 1.5px solid var(--line);
      border-radius: 8px;
      padding: 12px 16px;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      position: sticky;
      top: 10px;
      z-index: 20;
      box-shadow: 0 4px 12px rgba(15, 23, 42, 0.08);
    }

    .nav-tabs {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .tab-btn {
      padding: 7px 14px;
      border-radius: 6px;
      border: 1.5px solid var(--line);
      background: #f8fafc;
      color: var(--ink);
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
    }

    .tab-btn.active {
      background: var(--ink);
      color: #ffffff;
    }

    .search-input {
      padding: 7px 12px;
      border: 1.5px solid #94a3b8;
      border-radius: 6px;
      font-size: 13px;
      min-width: 240px;
    }

    .sheets-wrap {
      max-width: 1120px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 28px;
    }

    .sheet {
      background: var(--paper);
      border: 2px solid var(--line);
      border-radius: 6px;
      padding: 16px;
      box-shadow: 0 2px 8px rgba(15, 23, 42, 0.06);
    }

    /* En-tête type feuille d'arbitrage */
    .sheet-header {
      display: grid;
      grid-template-columns: 1.2fr 1.4fr 1fr;
      border: 1.5px solid var(--line);
      margin-bottom: 14px;
    }

    .header-box {
      padding: 10px 12px;
      border-right: 1.5px solid var(--line);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 6px;
    }

    .header-box:last-child {
      border-right: none;
    }

    .pool-big {
      font-size: 20px;
      font-weight: 800;
      letter-spacing: 0.02em;
    }

    .piste-tag {
      display: inline-block;
      margin-top: 4px;
      background: var(--accent-bg);
      color: var(--accent);
      border: 1.5px solid var(--accent);
      font-weight: 800;
      font-size: 13px;
      padding: 3px 10px;
      border-radius: 4px;
      width: fit-content;
    }

    .field-line {
      font-size: 12.5px;
      font-weight: 600;
      color: var(--muted);
      border-bottom: 1px dashed #94a3b8;
      padding-bottom: 3px;
    }

    .event-title {
      font-size: 16px;
      font-weight: 800;
      text-align: center;
    }

    .event-sub {
      font-size: 13px;
      font-weight: 700;
      text-align: center;
      color: var(--muted);
    }

    .meta-right {
      text-align: right;
      font-size: 12.5px;
      font-weight: 700;
    }

    .meta-date {
      font-size: 12px;
      color: var(--muted);
      text-align: right;
      margin-top: 4px;
    }

    /* Grille de poule */
    .grid-scroll {
      overflow-x: auto;
      margin-bottom: 16px;
    }

    table.pool-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 12.5px;
      min-width: 760px;
    }

    table.pool-table th,
    table.pool-table td {
      border: 1px solid var(--line);
      padding: 6px 8px;
    }

    table.pool-table thead th {
      background: #f1f5f9;
      text-align: center;
      font-weight: 800;
    }

    table.pool-table thead th.col-fencer {
      text-align: left;
    }

    .fencer-cell {
      white-space: nowrap;
    }

    .fencer-num {
      display: inline-block;
      width: 18px;
      font-weight: 800;
    }

    .fencer-nom {
      font-weight: 800;
    }

    .fencer-club {
      font-size: 11px;
      color: var(--muted);
      margin-left: 6px;
      font-weight: 600;
    }

    .bout-cell {
      width: 34px;
      height: 28px;
      text-align: center;
    }

    .diag-cell {
      background: var(--diag);
      position: relative;
    }

    .diag-cell::after {
      content: "✕";
      color: #64748b;
      font-size: 11px;
    }

    .sig-cell {
      min-width: 110px;
      color: #94a3b8;
      font-size: 11px;
      font-style: italic;
    }

    .highlight-row {
      background: var(--accent-bg);
    }

    /* Liste des matchs M1 à M21 */
    .bouts-title {
      font-size: 12px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 8px;
      color: var(--ink);
    }

    .bouts-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
      gap: 8px;
    }

    .bout-card {
      border: 1px solid var(--line);
      border-radius: 4px;
      padding: 6px 8px;
      background: #f8fafc;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 6px;
      font-size: 12px;
    }

    .bout-id {
      font-weight: 800;
      background: var(--ink);
      color: #ffffff;
      padding: 2px 6px;
      border-radius: 3px;
      font-size: 11px;
      flex-shrink: 0;
    }

    .bout-fighters {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 6px;
      min-width: 0;
    }

    .fighter-chip {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      font-weight: 600;
    }

    .fighter-chip strong {
      font-weight: 800;
    }

    .vs {
      font-size: 10px;
      font-weight: 800;
      color: var(--muted);
      flex-shrink: 0;
    }

    .score-inputs {
      display: flex;
      align-items: center;
      gap: 3px;
      flex-shrink: 0;
    }

    .score-inputs input {
      width: 30px;
      height: 22px;
      text-align: center;
      border: 1px solid #64748b;
      border-radius: 3px;
      background: #ffffff;
      font-size: 12px;
      font-weight: 700;
    }

    .sheet-footer {
      margin-top: 12px;
      padding-top: 8px;
      border-top: 1px solid var(--grid);
      display: flex;
      justify-content: space-between;
      font-size: 11px;
      color: var(--muted);
    }

    @media (max-width: 720px) {
      .sheet-header {
        grid-template-columns: 1fr;
      }
      .header-box {
        border-right: none;
        border-bottom: 1.5px solid var(--line);
      }
      .header-box:last-child {
        border-bottom: none;
      }
      .meta-right,
      .meta-date {
        text-align: left;
      }
    }

    @media print {
      body {
        background: #ffffff;
        padding: 0;
      }
      .top-bar {
        display: none;
      }
      .sheet {
        box-shadow: none;
        break-inside: avoid;
        margin-bottom: 16px;
      }
    }
  </style>
</head>
<body>
  <div class="top-bar">
    <div class="nav-tabs" id="navTabs">
      <button class="tab-btn active" data-pool="all">Toutes les poules (3)</button>
      <button class="tab-btn" data-pool="01">Poule n° 01 — Piste 2</button>
      <button class="tab-btn" data-pool="02">Poule n° 02 — Piste 4</button>
      <button class="tab-btn" data-pool="03">Poule n° 03 — Piste 6</button>
    </div>
    <input
      type="text"
      id="searchInput"
      class="search-input"
      placeholder="Rechercher tireuse ou club..."
    />
  </div>

  <div class="sheets-wrap" id="sheetsWrap"></div>

  <script>
    const EVENT_META = {
      epreuve: "Epée - Dames - M15",
      tour: "Poules Tour n°1",
      club: "SCO ESCRIME",
      date: "21/11/2026"
    };

    // Ordre des tireuses (1 à 7) et ordre des matchs M1 à M21 repris de EDM15_poules_arbitrage.pdf
    const POOLS = [
      {
        numero: "01",
        piste: "2",
        fencers: [
          { num: 1, nom: "CHAMAYOU", prenom: "Domitille", club: "AURAY ESC" },
          { num: 2, nom: "DIAKITE", prenom: "Maryam", club: "NANTES CEN" },
          { num: 3, nom: "SALMON RADENAC", prenom: "Romane", club: "LORIENT SE" },
          { num: 4, nom: "LE COURTOIS BÉZIER", prenom: "Victoire", club: "LAVAL CE" },
          { num: 5, nom: "LIOTHAUD", prenom: "Valentine", club: "ANGERS SCO" },
          { num: 6, nom: "BERNARD", prenom: "Alizee", club: "SABLES OLONN" },
          { num: 7, nom: "PONIN", prenom: "Noélia", club: "JA ST MALO" }
        ],
        bouts: [
          [1, 4], [2, 5], [3, 6], [4, 7], [5, 1], [6, 2], [7, 3],
          [1, 3], [4, 6], [2, 7], [5, 3], [1, 2], [4, 5], [6, 7],
          [3, 1], [6, 5], [2, 4], [7, 1], [3, 4], [5, 2], [7, 6]
        ]
      },
      {
        numero: "02",
        piste: "4",
        fencers: [
          { num: 1, nom: "MOREAU", prenom: "Mélia", club: "NEUVILLE 72" },
          { num: 2, nom: "BOLLENGIER-STRAGIER", prenom: "Elise", club: "NEUVILLE 72" },
          { num: 3, nom: "QUENON", prenom: "Chloé", club: "JA ST MALO" },
          { num: 4, nom: "GERARD", prenom: "Valentine", club: "ANGERS CSAD" },
          { num: 5, nom: "EON", prenom: "Alwena", club: "JA ST MALO" },
          { num: 6, nom: "VALOIS", prenom: "Isalys", club: "NIORT CE" },
          { num: 7, nom: "BERNARD", prenom: "Cecile", club: "RENNES CSG" }
        ],
        bouts: [
          [1, 4], [2, 5], [3, 6], [4, 7], [5, 1], [6, 2], [7, 3],
          [1, 3], [4, 6], [2, 7], [5, 3], [1, 2], [4, 5], [6, 7],
          [3, 1], [6, 5], [2, 4], [7, 1], [3, 4], [5, 2], [7, 6]
        ]
      },
      {
        numero: "03",
        piste: "6",
        fencers: [
          { num: 1, nom: "LOORIUS", prenom: "Yanna", club: "LOUDEAC" },
          { num: 2, nom: "ROCHEREAU", prenom: "Inès", club: "NANTES CEN" },
          { num: 3, nom: "GASTE", prenom: "Clara", club: "ANGERS SCO" },
          { num: 4, nom: "POUCH", prenom: "Zoe", club: "QUIMPER EC" },
          { num: 5, nom: "SAULNIER", prenom: "Emma", club: "NANTES CEN" },
          { num: 6, nom: "LOUSTAUNAU", prenom: "Raphaëlle", club: "ANGERS SCO" },
          { num: 7, nom: "FOULON-LIVET", prenom: "Clarisse", club: "LAVAL CE" }
        ],
        bouts: [
          [1, 4], [2, 5], [3, 6], [4, 7], [5, 1], [6, 2], [7, 3],
          [1, 3], [4, 6], [2, 7], [5, 3], [1, 2], [4, 5], [6, 7],
          [3, 1], [6, 5], [2, 4], [7, 1], [3, 4], [5, 2], [7, 6]
        ]
      }
    ];

    let activePool = "all";
    let searchTerm = "";

    const sheetsWrap = document.getElementById("sheetsWrap");
    const searchInput = document.getElementById("searchInput");
    const tabButtons = document.querySelectorAll(".tab-btn");

    function isMatch(f, q) {
      if (!q) return false;
      return (
        f.nom.toLowerCase().includes(q) ||
        f.prenom.toLowerCase().includes(q) ||
        f.club.toLowerCase().includes(q)
      );
    }

    function renderSheets() {
      const q = searchTerm.trim().toLowerCase();

      const poolsToRender = POOLS.filter(
        (p) =>
          (activePool === "all" || p.numero === activePool) &&
          (!q || p.fencers.some((f) => isMatch(f, q)))
      );

      if (poolsToRender.length === 0) {
        sheetsWrap.innerHTML = `<div class="sheet" style="text-align:center;color:#475569;">Aucune tireuse ou poule trouvée pour « ${searchTerm} ».</div>`;
        return;
      }

      sheetsWrap.innerHTML = poolsToRender
        .map((pool) => {
          const byNum = Object.fromEntries(pool.fencers.map((f) => [f.num, f]));

          const headerCols = pool.fencers
            .map((f) => `<th style="width:34px;">${f.num}</th>`)
            .join("");

          const bodyRows = pool.fencers
            .map((rowFencer) => {
              const hit = isMatch(rowFencer, q);
              const cells = pool.fencers
                .map((colFencer) => {
                  if (rowFencer.num === colFencer.num) {
                    return `<td class="bout-cell diag-cell"></td>`;
                  }
                  return `<td class="bout-cell"></td>`;
                })
                .join("");

              return `
                <tr class="${hit ? "highlight-row" : ""}">
                  <td class="fencer-cell">
                    <span class="fencer-num">${rowFencer.num}</span>
                    <span class="fencer-nom">${rowFencer.nom}</span>
                    <span>${rowFencer.prenom}</span>
                    <span class="fencer-club">${rowFencer.club}</span>
                  </td>
                  ${cells}
                  <td class="sig-cell">Signature</td>
                </tr>
              `;
            })
            .join("");

          const boutsHtml = pool.bouts
            .map(([aNum, bNum], idx) => {
              const fA = byNum[aNum];
              const fB = byNum[bNum];
              const hitA = isMatch(fA, q);
              const hitB = isMatch(fB, q);

              return `
                <div class="bout-card ${hitA || hitB ? "highlight-row" : ""}">
                  <span class="bout-id">M${idx + 1}</span>
                  <div class="bout-fighters">
                    <span class="fighter-chip" title="${fA.nom} ${fA.prenom}">
                      <strong>${fA.num}</strong> ${fA.nom}
                    </span>
                    <span class="vs">-</span>
                    <span class="fighter-chip" title="${fB.nom} ${fB.prenom}">
                      <strong>${fB.num}</strong> ${fB.nom}
                    </span>
                  </div>
                  <div class="score-inputs">
                    <input type="text" maxlength="2" aria-label="Score ${fA.nom}" />
                    <span>/</span>
                    <input type="text" maxlength="2" aria-label="Score ${fB.nom}" />
                  </div>
                </div>
              `;
            })
            .join("");

          return `
            <article class="sheet">
              <div class="sheet-header">
                <div class="header-box">
                  <div class="pool-big">Poule n° ${pool.numero}</div>
                  <div class="piste-tag">Piste ${pool.piste}</div>
                </div>
                <div class="header-box">
                  <div class="field-line">Arbitre :</div>
                  <div class="event-title">${EVENT_META.epreuve}</div>
                  <div class="event-sub">${EVENT_META.tour}</div>
                </div>
                <div class="header-box">
                  <div class="meta-right">${EVENT_META.club}</div>
                  <div class="meta-date">${EVENT_META.date}</div>
                </div>
              </div>

              <div class="grid-scroll">
                <table class="pool-table">
                  <thead>
                    <tr>
                      <th class="col-fencer">Tireuses (1 à 7)</th>
                      ${headerCols}
                      <th>Signature</th>
                    </tr>
                  </thead>
                  <tbody>${bodyRows}</tbody>
                </table>
              </div>

              <div class="bouts-title">Ordre des matchs (M1 à M21)</div>
              <div class="bouts-grid">${boutsHtml}</div>

              <div class="sheet-footer">
                <span>Poule n° ${pool.numero} — Piste ${pool.piste}</span>
                <span>BellePoule — EDM15_poules_arbitrage.pdf</span>
              </div>
            </article>
          `;
        })
        .join("");
    }

    tabButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        tabButtons.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        activePool = btn.dataset.pool;
        renderSheets();
      });
    });

    searchInput.addEventListener("input", (e) => {
      searchTerm = e.target.value;
      renderSheets();
    });

    renderSheets();
  </script>
</body>
</html>
